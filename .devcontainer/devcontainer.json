// Dev container for GitHub Codespaces (and VS Code "Reopen in Container").
// Opens directly in workbench/ with Python, Jupyter and the locked .venv ready,
// so a new Codespace needs no manual setup. The setup steps live in
// post-create.sh; this file only declares the image, folder, and extensions.
{
  "name": "PSL Workbench (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Open the workbench folder itself so its .vscode settings and tasks apply.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/workbench",

  // uv's cache and the .venv sit on different filesystems here; copying
  // instead of hard-linking avoids a warning on every install.
  "containerEnv": { "UV_LINK_MODE": "copy" },

  // Runs from workspaceFolder (workbench/), hence the relative path.
  "postCreateCommand": "bash ../.devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.datawrangler"
      ],
      "settings": {
        // Container-only path (Linux layout); Windows users select .venv themselves.
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
