// Dev container for GitHub Codespaces (and VS Code "Reopen in Container").
// Opens directly in workbench/ with Python, Jupyter and the locked .venv ready.
// Setup steps live in the scripts next to this file; this file only declares
// the image, folder, ports and extensions.
{
  "name": "statsbench (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Open the workbench folder itself so its .vscode settings and tasks apply.
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/workbench",

  // uv's cache and the .venv sit on different filesystems here; copying
  // instead of hard-linking avoids a warning on every install.
  "containerEnv": { "UV_LINK_MODE": "copy" },

  // Git LFS: a Codespace first opened on the default image installs an LFS
  // pre-push hook; without git-lfs here, every later push fails on that hook.
  "features": { "ghcr.io/devcontainers/features/git-lfs:1": {} },

  // Both run from workspaceFolder (workbench/), hence the relative paths.
  // Once, when the Codespace is created: install uv, build .venv (+ JupyterLab).
  "postCreateCommand": "bash ../.devcontainer/post-create.sh",
  // Every start, including after Stop/Resume: bring JupyterLab back up.
  "postStartCommand": "bash ../.devcontainer/start-lab.sh",

  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.datawrangler"
      ],
      "settings": {
        // Container-only path (Linux layout); Windows users select .venv themselves.
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
