{
  // Ctrl+Shift+P -> "Tasks: Run Task" -> pick one. Uses the interpreter selected
  // in VS Code (the .venv), so no shell activation or quoting is needed.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "psl: find",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "psl", "find", "${input:query}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "psl: show entry",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "psl", "show", "${input:entryId}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "psl: R name lookup",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "psl", "r", "${input:rName}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "psl: environment check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "psl.envcheck"],
      "problemMatcher": []
    },
    {
      "label": "psl: run tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "problemMatcher": [],
      "group": "test"
    }
  ],
  "inputs": [
    { "id": "query", "type": "promptString", "description": "Task or R name, e.g. inverse logit / plogis / best subset" },
    { "id": "entryId", "type": "promptString", "description": "Entry id from psl find, e.g. expit" },
    { "id": "rName", "type": "promptString", "description": "R function name, e.g. glm (blank = full table)" }
  ]
}
