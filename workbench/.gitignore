# Environment and caches (recreated by `uv sync`)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Local data caches: keep raw course data out of Git
/data/
*.parquet
*.feather

# Your coursework stays local by default (see coursework/README.md)
coursework/*
!coursework/README.md
